def check_membership(user_id):
    try:
        c_s = bot.get_chat_member(CHANNEL_USERNAME, user_id).status
        g_s = bot.get_chat_member(GROUP_USERNAME, user_id).status
        return c_s in ['creator', 'administrator', 'member'] and g_s in ['creator', 'administrator', 'member']
    except: return False

