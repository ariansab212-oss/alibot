    if check_membership(message.from_user.id): show_main_menu(message.chat.id)
    else:
        markup = types.InlineKeyboardMarkup(row_width=1)
        markup.add(types.InlineKeyboardButton("📢 Ali_NUMBERS", url=CHANNEL_LINK), types.InlineKeyboardButton("💬 MyOtpGroup123", url=GROUP_LINK), types.InlineKeyboardButton("🟢 Verify", callback_data="verify_sub"))
